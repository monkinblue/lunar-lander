# ElevenLabs API Key for offline CLI audio asset generation (npm run generate:audio)
# Never expose this variable with a VITE_ prefix so it never enters the client bundle.
ELEVENLABS_API_KEY=your_api_key_here

# Optional: Override MU-TH-UR 6000 clinical female voice ID (auto-selected via /v1/voices if omitted)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
